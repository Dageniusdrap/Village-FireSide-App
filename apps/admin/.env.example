NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Never prefix with NEXT_PUBLIC_ and never import from a "use client" component.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Only for `pnpm provision:test-accounts` (see docs/test-accounts.md).
# Real values go in .env.local, never in this file.
TEST_ADMIN_PASSWORD=choose-a-strong-password
TEST_TEACHER_PASSWORD=choose-a-strong-password
TEST_LISTENER_PASSWORD=choose-a-strong-password
